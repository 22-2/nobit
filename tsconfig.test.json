{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["node", "vitest/globals", "obsidian-typings"],
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "es2020",
		"verbatimModuleSyntax": false
	},
	"include": [
		"src/**/*",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"**/__tests__/**/*",
		"vitest.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"e2e"
	]
}