{
	"name": "obsidian-nobit",
	"type": "module",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "pnpm dlx tsx esbuild.config.mts",
		"build": "pnpm dlx tsx esbuild.config.mts production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "tsc -noEmit -skipLibCheck",
		"repomix": "pnpm dlx repomix && code ./repomix-output.md",
		"test": "vitest --run",
		"test:parallel": "vitest --run --reporter=verbose",
		"test:watch": "vitest",
		"test:coverage": "vitest --coverage",
		"test:ci": "vitest --run --coverage --reporter=verbose",
		"test:e2e": "playwright test",
		"test:e2e:example": "pnpm playwright test e2e/specs/example.spec.ts --project=chromium",
		"test:e2e:debug": "cross-env DEBUG=pw:api playwright test",
		"manual": "pnpm dlx tsx e2e/manual.ts",
		"manual:sandbox": "pnpm dlx tsx e2e/manual.ts --sandbox",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@electron/asar": "^4.0.1",
		"@playwright/test": "^1.56.0",
		"@storybook/addon-svelte-csf": "5.0.10",
		"@storybook/svelte-vite": "9.1.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tsconfig/svelte": "^5.0.5",
		"@types/he": "^1.2.3",
		"@types/node": "24.7.0",
		"@types/semver": "^7.7.1",
		"@vitest/coverage-v8": "^3.2.4",
		"builtin-modules": "5.0.0",
		"chalk": "^5.6.2",
		"dotenv": "^17.2.3",
		"electron": "^38.2.2",
		"esbuild": "0.25.10",
		"esbuild-svelte": "^0.9.3",
		"loglevel-plugin-prefix": "^0.8.4",
		"obsidian": "^1.10.0",
		"obsidian-typings": "4.58.0",
		"playwright": "^1.56.0",
		"semver": "^7.7.3",
		"storybook": "9.1.10",
		"svelte-preprocess": "^6.0.3",
		"tiny-invariant": "^1.3.3",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"vite": "^7.1.9",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"date-fns": "^4.1.0",
		"he": "^1.2.0",
		"loglevel": "^1.9.2",
		"lucide-svelte": "^0.545.0",
		"svelte": "^5.39.11",
		"zod": "^4.1.12"
	},
	"packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa"
}
